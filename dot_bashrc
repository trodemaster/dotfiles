# ~/.bashrc: loaded by non-login interactive shells and VS Code SDK shell init.

case $- in
    *i*) ;;
      *)
        export BASH_ENV="${HOME}/.bash_env"
        source "$BASH_ENV"
        return
        ;;
esac

# Ubuntu system bash completion
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Source .bash_profile so non-login shells (desktop terminals) get the same config
[[ -f "${HOME}/.bash_profile" ]] && source "${HOME}/.bash_profile"
