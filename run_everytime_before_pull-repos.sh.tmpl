#!/bin/bash
# Fast-forward the working checkouts under ~/Developer (machine-cfg and dotfiles) to their upstream
# on every apply, before chezmoi renders templates and links files, so the new content is what gets
# applied. (chezmoi's own source copy, ~/.local/share/chezmoi, is pulled by `chezmoi update`; the
# ~/Developer/dotfiles working copy is not, so it falls behind without this.)
# Never fails the apply: a missing checkout is skipped; a failed pull (dirty/conflicting tree,
# diverged branch, no network, auth) only prints a one-line warning.
REPOS="machine-cfg dotfiles"
DEV="{{ .chezmoi.homeDir }}/Developer"

# HTTPS remotes; git's configured credential helper supplies the login. Never prompt: a prompt
# would hang the apply.
export GIT_TERMINAL_PROMPT=0

TIMEOUT=()
if command -v timeout >/dev/null 2>&1; then TIMEOUT=(timeout 60); fi

pull_repo() {
    local name="$1" dir="$DEV/$1" out
    [ -d "$dir/.git" ] || return 0
    # direnv picks the right GitHub account (GH_CONFIG_DIR) from .envrc; it only fires in an
    # interactive shell, so wrap the pull the way ~/.bash_env does.
    local git=(git)
    if command -v direnv >/dev/null 2>&1; then git=(direnv exec "$dir" git); fi
    if out=$(cd "$dir" && "${TIMEOUT[@]}" "${git[@]}" pull --ff-only --quiet 2>&1); then
        [ -n "$out" ] && echo "$out"
        echo "$name: up to date ($(git -C "$dir" rev-parse --short HEAD))"
    else
        # drop git's multi-line "hint:" advice; keep the fatal:/error: lines, joined on one line
        echo "warning: $name not updated: $(printf '%s\n' "$out" | grep -v '^hint:' | grep -v '^[[:space:]]*$' | tr '\n' ' ' | sed 's/ *$//')" >&2
    fi
}

for r in $REPOS; do pull_repo "$r"; done
exit 0
