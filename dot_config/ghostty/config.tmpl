theme = Nocturnal Winter
{{- if eq .chezmoi.os "darwin" }}
font-family = SauceCodePro Nerd Font Mono
font-size = 18
{{- else }}
# Linux/fontconfig matches by the font's actual family name, not the
# filename-derived PostScript name that works on macOS/CoreText.
font-family = "SauceCodePro Nerd Font Mono"
font-size = 14
{{- end }}


## claude code optimizations
# https://code.claude.com/docs/en/terminal-config

# enable option key as alt for claude shortcuts (option+enter=newline, option+p=model switch)
{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = true
{{- end }}

# progress bars via ConEmu OSC 9;4 (default: true, explicit for clarity)
progress-style = true

# larger scrollback for long claude sessions (10MB vs default ~1MB)
scrollback-limit = 10000000

# smoother scrolling: finer precision-device steps, snappier discrete wheel
mouse-scroll-multiplier = precision:0.5,discrete:5

# enhanced shell integration: ssh-env for remote claude sessions
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

## command reference
# ghostty +reload_config
# ghostty +show-config --default --docs

split-divider-color = #910f0f

## split keybinds (arrow-based)
# Avoids: Rectangle (ctrl+opt+arrows, cmd+opt+left/right, ctrl+shift+left/right),
# Ghostty jump_to_prompt (cmd+shift+up/down), readline word-nav (alt+left/right),
# and macOS Mission Control (ctrl+arrows). cmd+d / cmd+shift+d still work.
# new split:   cmd+ctrl+arrow
# focus split: cmd+opt+shift+arrow
# resize:      cmd+ctrl+shift+arrow
keybind = cmd+ctrl+up=new_split:up
keybind = cmd+ctrl+down=new_split:down
keybind = cmd+ctrl+left=new_split:left
keybind = cmd+ctrl+right=new_split:right
keybind = cmd+alt+shift+up=goto_split:up
keybind = cmd+alt+shift+down=goto_split:down
keybind = cmd+alt+shift+left=goto_split:left
keybind = cmd+alt+shift+right=goto_split:right
keybind = cmd+ctrl+shift+up=resize_split:up,40
keybind = cmd+ctrl+shift+down=resize_split:down,40
keybind = cmd+ctrl+shift+left=resize_split:left,40
keybind = cmd+ctrl+shift+right=resize_split:right,40

