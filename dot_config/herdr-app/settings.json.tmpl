{
  "theme": "nocturnal-winter",
  "font": "SauceCodePro Nerd Font Mono",
{{- if eq .chezmoi.os "darwin" }}
  "font_size": 15,
  "zoom": 1.2,
{{- else }}
  "font_size": 14,
{{- end }}
  "sounds": {
    "enabled": true
  },
  "font_ligatures": false,
  "terminal_line_height": 1.0,
  "terminal_cell_width": 1.0,
  "terminal_scroll_speed": 1.0,
  "minimum_contrast": 1.0
}
