#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'
shopt -s nullglob nocaseglob

# check if nrsc5 is running and kill it
if (pgrep nrsc5); then
  echo "stopping Kexp"
  pkill -15 nrsc5
  exit 0
fi

# ad-hoc listening uses the E4000 dongle (sdr0) on inky; the R820T (port 1235) is reserved
# for the streamarchive recorder on darkstar, and rtl_tcp serves one client per dongle.
echo "connecting to inky.jibb.tv:1234"
/opt/local/bin/nrsc5 -H inky.jibb.tv:1234 -g 6 90.3 0

exit 0