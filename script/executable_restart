#!/usr/bin/env bash
# Reboot the machine; on macOS with FileVault, do an authenticated restart so the
# disk unlocks without a password prompt at the login window.
# Usage: restart [reboot|restart]   (both are the same action)
#   macOS: sudo fdesetup authrestart (falls back to shutdown -r if FileVault is off)
#   Linux: sudo systemctl reboot
set -euo pipefail

case "${1:-reboot}" in
    reboot|restart) ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: ${0##*/} [reboot|restart]" >&2; exit 2 ;;
esac

case "$(uname -s)" in
    Darwin)
        if fdesetup status | grep -q 'FileVault is On'; then
            exec sudo fdesetup authrestart
        fi
        echo "FileVault is off; doing a plain restart" >&2
        exec sudo shutdown -r now
        ;;
    Linux)
        exec sudo systemctl reboot
        ;;
    *)
        echo "unsupported OS: $(uname -s)" >&2
        exit 1
        ;;
esac
