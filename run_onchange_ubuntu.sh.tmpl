#!/usr/bin/env bash

{{ if eq .chezmoi.os "linux" }}
{{ if eq .chezmoi.osRelease.id "ubuntu" }}
echo running onchange_ubuntu.sh

# set service restart to automatic
sudo sed -i "/#\$nrconf{restart} = 'i';/s/.*/\$nrconf{restart} = 'a';/" /etc/needrestart/needrestart.conf

# Variables with default values
TMPDIR="${TMPDIR:-/var/tmp}"

# check architecture
ARCH=$(dpkg --print-architecture)
ARCH_LONG=${ARCH/arm64/aarch64}

# detect whether a desktop session is installed (any DE/WM - checks for
# xsessions/wayland-sessions entries rather than gnome-session specifically,
# since e.g. Ubuntu Budgie has no gnome-session binary). Used to gate
# desktop-only installs (ghostty, chrome, etc.) below.
HAS_DESKTOP_SESSION=false
if compgen -G "/usr/share/xsessions/*.desktop" >/dev/null || compgen -G "/usr/share/wayland-sessions/*.desktop" >/dev/null; then
  HAS_DESKTOP_SESSION=true
fi

# add hashicorp gpg key
if ! [[ -f /usr/share/keyrings/hashicorp-archive-keyring.gpg ]]; then
  echo "Adding Hashicorp GPG key..."
  wget -O- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
  sudo chmod 644 /usr/share/keyrings/hashicorp-archive-keyring.gpg
else
  sudo chmod 644 /usr/share/keyrings/hashicorp-archive-keyring.gpg
fi

# add hashicorp repo
if ! [[ -f /etc/apt/sources.list.d/hashicorp.list ]]; then
  echo "Adding Hashicorp repo..."
  
  CURRENT_RELEASE=$(lsb_release -cs)
  
  # Check if current release is available in Hashicorp repo
  if curl -s -o /dev/null -w "%{http_code}" "https://apt.releases.hashicorp.com/dists/${CURRENT_RELEASE}/Release" | grep -q "200"; then
    SELECTED_RELEASE="$CURRENT_RELEASE"
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com ${SELECTED_RELEASE} main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
  else
    # Use questing (25.10) as fallback - most recent HashiCorp-supported release before resolute
    SELECTED_RELEASE="questing"
    echo "Current release $CURRENT_RELEASE not available, using: $SELECTED_RELEASE"
    # allow-codename-mismatch needed when using a fallback release on a newer Ubuntu
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg allow-codename-mismatch=yes] https://apt.releases.hashicorp.com ${SELECTED_RELEASE} main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
  fi
  sudo chmod 644 /etc/apt/sources.list.d/hashicorp.list
fi

echo "Updating apt cache..."
sudo apt update >/dev/null

# list of apt packages to install
APT_PACKAGES=(
  "virt-what"
  "jq"
  "git"
  "wget"
  "unzip"
  "tmux"
  "tree"
  "acl"
  "apt-transport-https"
  "ca-certificates"
  "lsb-release"
  "vault"
  "curl"
  "gh"
  "duf"
  "shellcheck"
  "build-essential"
  "eza"
  "btop"
  "plocate"
)

# loop over apt packages and install them
for APT_PACKAGE in "${APT_PACKAGES[@]}"; do
  if ! dpkg -s $APT_PACKAGE &>/dev/null; then
    echo "Installing apt package $APT_PACKAGE..."
    sudo apt-get install -y --fix-missing $APT_PACKAGE
  fi
done

# sudo apt update

# make sure the ~/.font dir exists
if ! [[ -d ${HOME}/.fonts ]]; then
  mkdir ${HOME}/.fonts
fi

## check if source-code-pro font is already installed
#if ! [[ -f ${HOME}/.fonts/SourceCodePro-Medium.otf ]]; then
#  echo "Installing Source Code Pro font..."
#  wget -q https://github.com/adobe-fonts/source-code-pro/releases/download/2.038R-ro%2F1.058R-it%2F1.018R-VAR/OTF-source-code-pro-2.038R-ro-1.058R-it.zip
#  unzip -o -d ${HOME}/.fonts ${HOME}/OTF-source-code-pro*.zip SourceCodePro-Medium.otf
#  rm ${HOME}/OTF-source-code-pro*.zip
#fi

# check if sauce-code-pro font is already installed
if ! [[ -f ${HOME}/.fonts/SauceCodeProNerdFontMono-Regular.ttf ]]; then
  echo "Installing Sauce Code Pro font..."
  wget -q https://github.com/ryanoasis/nerd-fonts/releases/download/v3.2.1/SourceCodePro.zip
  unzip -o -d ${HOME}/.fonts ${HOME}/SourceCodePro.zip SauceCodeProNerdFontMono-Regular.ttf
  rm ${HOME}/SourceCodePro.zip
fi

# install latest fzf binary from github release
if ! [[ -f /usr/local/bin/fzf ]]; then
  echo "Installing fzf..."
  if [[ -x /usr/bin/fzf ]]; then
    echo "Uninstalling system fzf..."
    sudo apt remove -y fzf
  fi
  FZF_VERSION=$(curl -s https://api.github.com/repos/junegunn/fzf/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")')
  FZF_FILENAME="fzf-${FZF_VERSION//v/}-linux_${ARCH}.tar.gz"
  FZF_DOWNLOAD_URL="https://github.com/junegunn/fzf/releases/download/${FZF_VERSION}/${FZF_FILENAME}"
  echo "Downloading fzf version ${FZF_DOWNLOAD_URL}..."
  wget -q ${FZF_DOWNLOAD_URL}
  tar xzf ${FZF_FILENAME}
  sudo mv fzf /usr/local/bin/fzf
  rm ${FZF_FILENAME}
fi

# check for powerline-go (use -s to catch 0-byte placeholder from a rate-limited download)
if ! [[ -s /usr/local/bin/powerline-go ]]; then
  echo "Installing powerline-go..."
  POWERLINE_GO_URL=$(wget -q -O - 'https://api.github.com/repos/justjanne/powerline-go/releases/latest' | jq -r ".assets[] | select(.name==\"powerline-go-linux-$ARCH\").browser_download_url")
  if [[ -n "$POWERLINE_GO_URL" ]]; then
    wget -q -O "${TMPDIR}/powerline-go" "$POWERLINE_GO_URL" && \
      chmod +x "${TMPDIR}/powerline-go" && \
      sudo mv "${TMPDIR}/powerline-go" /usr/local/bin/
  else
    echo "powerline-go: could not resolve download URL (GitHub API rate limit?), skipping"
    rm -f "${TMPDIR}/powerline-go"
  fi
fi

# install chezmoi from github release .deb (puts chezmoi in /usr/bin, standard PATH)
if ! dpkg -s chezmoi &>/dev/null; then
  echo "Installing chezmoi..."
  CHEZMOI_VERSION=$(curl -s https://api.github.com/repos/twpayne/chezmoi/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")')
  CHEZMOI_FILENAME="chezmoi_${CHEZMOI_VERSION//v/}_linux_${ARCH}.deb"
  CHEZMOI_DOWNLOAD_URL="https://github.com/twpayne/chezmoi/releases/download/${CHEZMOI_VERSION}/${CHEZMOI_FILENAME}"
  echo "Downloading chezmoi ${CHEZMOI_VERSION}..."
  wget -q -O "${TMPDIR}/chezmoi.deb" "$CHEZMOI_DOWNLOAD_URL"
  sudo dpkg -i "${TMPDIR}/chezmoi.deb"
  rm "${TMPDIR}/chezmoi.deb"
fi

# install fastfetch
if ! [[ -f /usr/bin/fastfetch ]]; then
  echo "Installing fastfetch..."
  FASTFETCH_URL=$(wget -q -O - 'https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest' | jq -r ".assets[] | select(.name | contains(\"$ARCH_LONG.deb\")).browser_download_url")
  wget -q -O "${TMPDIR}/fastfetch-linux-$ARCH_LONG.deb" "$FASTFETCH_URL"
  sudo dpkg -i "${TMPDIR}/fastfetch-linux-$ARCH_LONG.deb"
  rm "${TMPDIR}/fastfetch-linux-$ARCH_LONG.deb"
  if sudo lshw -class system -json | jq .[].product | grep -q "Apple Virtualization Generic Platform"; then
    echo "fastfetch > ~/.ssh/rc"
  fi
fi

# install ghostty if a desktop session is available
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  if ! command -v ghostty &>/dev/null; then
    echo "Installing ghostty..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)"
  fi
fi

# install google chrome if a desktop session is available (amd64 only -
# google doesn't publish an arm64 desktop .deb)
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  if ! dpkg -s google-chrome-stable &>/dev/null; then
    if [[ "$ARCH" == "amd64" ]]; then
      echo "Installing google chrome..."
      CHROME_DEB="${TMPDIR}/google-chrome-stable_current_amd64.deb"
      wget -q -O "$CHROME_DEB" "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
      sudo apt-get install -y "$CHROME_DEB"
      rm -f "$CHROME_DEB"
    else
      echo "Warning: google chrome has no official $ARCH .deb, skipping"
    fi
  fi
fi

# install visual studio code if a desktop session is available
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  if ! dpkg -s code &>/dev/null; then
    echo "Installing visual studio code..."
    VSCODE_OS=$([[ "$ARCH" == "arm64" ]] && echo "linux-deb-arm64" || echo "linux-deb-x64")
    VSCODE_DEB="${TMPDIR}/vscode-${ARCH}.deb"
    wget -q -O "$VSCODE_DEB" "https://code.visualstudio.com/sha/download?build=stable&os=${VSCODE_OS}"
    # code's postinst prompts (whiptail) to add the MS apt repo; noninteractive
    # frontend takes the default (yes) without blocking on a tty
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$VSCODE_DEB"
    rm -f "$VSCODE_DEB"
  fi
fi

# bump idle-lock timeout - default 5 min (300s) is too aggressive for active
# desktop use; requires an active session dbus, so warn (not fatal) if run
# before first graphical login
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  if ! gsettings set org.gnome.desktop.session idle-delay 1800 2>/dev/null; then
    echo "Warning: could not set idle-delay (no active desktop session?), skipping"
  fi
fi

# always start sessions with numlock on, and don't let it drift based on
# whatever state it was left in at last logout
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  if ! gsettings set org.gnome.desktop.peripherals.keyboard numlock-state true 2>/dev/null; then
    echo "Warning: could not set numlock-state (no active desktop session?), skipping"
  fi
  gsettings set org.gnome.desktop.peripherals.keyboard remember-numlock-state false 2>/dev/null
fi

{{ if eq .chezmoi.hostname "darkstar" }}
# Mac keyboard on Mac hardware: map Command (reported as Super/Win) to Ctrl
# via the XKB altwin:ctrl_win option, so Cmd+C/Cmd+V etc. work as copy/paste.
# The physical Ctrl key keeps working too (this adds Command as an additional
# Ctrl, it doesn't replace it).
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  CURRENT_XKB_OPTIONS=$(gsettings get org.gnome.desktop.input-sources xkb-options 2>/dev/null)
  if [[ -z "$CURRENT_XKB_OPTIONS" ]]; then
    echo "Warning: could not read xkb-options (no active desktop session?), skipping Command-key remap"
  elif [[ "$CURRENT_XKB_OPTIONS" != *"altwin:ctrl_win"* ]]; then
    if [[ "$CURRENT_XKB_OPTIONS" == "@as []" || "$CURRENT_XKB_OPTIONS" == "[]" ]]; then
      NEW_XKB_OPTIONS="['altwin:ctrl_win']"
    else
      NEW_XKB_OPTIONS="${CURRENT_XKB_OPTIONS%]}, 'altwin:ctrl_win']"
    fi
    gsettings set org.gnome.desktop.input-sources xkb-options "$NEW_XKB_OPTIONS"
  fi
fi

# F-key app launch shortcuts, mirroring the skhd F-key scheme on umac
# (machine-cfg/umac/skhdrc), adapted to whatever's actually installed here.
# Declarative: re-running this always sets custom0-6 to this exact list, so
# it's the source of truth (like skhdrc is on umac) rather than a one-time
# seed.
if [[ "$HAS_DESKTOP_SESSION" == true ]]; then
  MK_BASE="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"
  MK_NAMES=(
    "Ghostty"
    "Xfce Terminal"
    "VS Code"
    "Obsidian"
    "Google Chrome"
    "Thunderbird"
    "1Password"
  )
  MK_COMMANDS=(
    "/usr/bin/ghostty --gtk-single-instance=true"
    "xfce4-terminal"
    "code"
    "obsidian"
    "google-chrome-stable"
    "thunderbird"
    "1password"
  )
  MK_BINDINGS=(
    "F1"
    "<Alt>F1"
    "F2"
    "<Alt>F2"
    "F3"
    "F4"
    "F6"
  )

  MK_PATHS="["
  for i in "${!MK_NAMES[@]}"; do
    MK_PATH="${MK_BASE}/custom${i}/"
    MK_PATHS+="'${MK_PATH}', "
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:"${MK_PATH}" name "${MK_NAMES[$i]}" 2>/dev/null
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:"${MK_PATH}" command "${MK_COMMANDS[$i]}" 2>/dev/null
    gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:"${MK_PATH}" binding "${MK_BINDINGS[$i]}" 2>/dev/null
  done
  MK_PATHS="${MK_PATHS%, }]"

  if ! gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$MK_PATHS" 2>/dev/null; then
    echo "Warning: could not set F-key app shortcuts (no active desktop session?), skipping"
  fi
fi
{{ end }}

{{ end }}
{{ end }}

exit 0
