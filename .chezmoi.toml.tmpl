{{- /* macOS: python version is pinned here and applied by run_onchange_after_python.sh.tmpl. Bump to change the default. */ -}}
{{- $python_vers := "3.14" -}}
{{- /* elsewhere the distro decides: follow whatever /usr/bin/python3 is */ -}}
{{- if and (ne .chezmoi.os "darwin") (stat "/usr/bin/python3") -}}
{{-   $raw := output "/usr/bin/python3" "--version" | trim -}}
{{-   $python_vers = regexReplaceAll "Python (\\d+\\.\\d+).*" $raw "${1}" -}}
{{- end -}}
{{- $python_vers_ports := replace "." "" $python_vers -}}
{{- $isDesktop := false -}}
{{- if stat "/usr/bin/gnome-session" -}}
{{-   $isDesktop = true -}}
{{- end -}}

[data]
    python_vers_ports = "{{ $python_vers_ports }}"
    python_vers = "{{ $python_vers }}"
    isDesktop = {{ $isDesktop }}

[scriptEnv]

