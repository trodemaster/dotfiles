#!/usr/bin/env bash

{{ if eq .chezmoi.os "darwin" }}

# GitHub API helper: tries unauthenticated first, falls back to gh auth token on rate limit
github_api() {
  local response
  response=$(curl -s "$@")
  if echo "$response" | grep -q "API rate limit exceeded"; then
    local token="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)}"
    if [[ -n "$token" ]]; then
      response=$(curl -s -H "Authorization: token $token" "$@")
    fi
    if echo "$response" | grep -q "API rate limit exceeded"; then
      echo "Warning: GitHub API rate limit exceeded for $* - revisit this install later" >&2
    fi
  fi
  echo "$response"
}

# configure sudoers
if ! [[ -f /etc/sudoers.d/admin ]]; then
  echo "Adding admin group to sudoers..."
  echo '%admin     ALL=(ALL)       NOPASSWD: ALL' | sudo tee /etc/sudoers.d/admin
fi

# test for xcode command line tools by looking for /Library/Developer/CommandLineTools
if ! [[ -d /Library/Developer/CommandLineTools ]]; then
  echo "Installing xcode command line tools..."
  touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  CMDLINE_TOOLS=$(softwareupdate -l | grep "\*.*Command Line" | tail -n 1 | sed 's/^[^C]* //')
  softwareupdate -i "$CMDLINE_TOOLS" --verbose
fi

# accept the xcode license if it hasn't been accepted yet
if ! xcodebuild -license check >/dev/null 2>&1; then
  echo "Accepting xcode license..."
  sudo xcodebuild -license accept || echo "Warning: could not accept xcode license, skipping"
fi

# create ~/Developer if it doesn't exist
if [[ ! -d {{ (joinPath .chezmoi.homeDir "Developer") | quote }} ]]; then
  mkdir -p {{ (joinPath .chezmoi.homeDir "Developer") | quote }}
fi

# determine CPU architecture
ARCH=$(uname -m)
ARCH=${ARCH/x86_64/amd64}
ARCH=${ARCH/aarch64/arm64}

# get latest release version from github for macports
PORT_LATEST_RELEASE=$(github_api https://api.github.com/repos/macports/macports-base/releases/latest | grep tag_name | cut -d '"' -f 4)
PORT_LATEST_RELEASE_NUMBER=${PORT_LATEST_RELEASE#v}

# get macOS operating system version long name including california parks using system_profiler
MACOS_VERSION=$(sw_vers --ProductVersion | cut -d . -f1)
MACOS_VERSION_NAME=$(awk '/SOFTWARE LICENSE AGREEMENT FOR macOS/' '/System/Library/CoreServices/Setup Assistant.app/Contents/Resources/en.lproj/OSXSoftwareLicense.rtf' | awk -F 'macOS ' '{print $NF}' | awk '{print substr($0, 0, length($0)-1)}')

# test for macports and install if not present
if ! command -v /opt/local/bin/port &>/dev/null; then
  echo "Installing macports..."
  MACOS_VERSION=$(sw_vers -productVersion | cut -f 1 -d .)
  if [[ $MACOS_VERSION -ge 27 ]]; then
    cd
    echo "macOS version $MACOS_VERSION is not supported by macports installer"
    echo "Attempting install from source..."
    curl -O https://distfiles.macports.org/MacPorts/MacPorts-${PORT_LATEST_RELEASE_NUMBER}.tar.bz2
    tar xf MacPorts-${PORT_LATEST_RELEASE_NUMBER}.tar.bz2
    cd MacPorts-${PORT_LATEST_RELEASE_NUMBER}/
    ./configure
    make
    sudo make install
    cd
    rm -rf MacPorts-${PORT_LATEST_RELEASE_NUMBER}*
  else
    MACPORTS_PKG="https://github.com/macports/macports-base/releases/download/${PORT_LATEST_RELEASE}/MacPorts-${PORT_LATEST_RELEASE_NUMBER}-${MACOS_VERSION}-${MACOS_VERSION_NAME}.pkg"
    echo $MACPORTS_PKG
    curl -s -L -o /tmp/macports.pkg $MACPORTS_PKG
    sudo installer -pkg /tmp/macports.pkg -target /
    rm /tmp/macports.pkg
  fi
fi

# configure macports sources
# These lines change the rendered script when a port tree is cloned, so run_onchange reruns it
# blakeports present: {{ stat (joinPath .chezmoi.homeDir "Developer/blakeports") | not | not }}
# blakeports-private present: {{ stat (joinPath .chezmoi.homeDir "Developer/blakeports-private") | not | not }}
# Always write sources.conf so blakeports-private (private ports) precedes blakeports
if [[ -d {{ (joinPath .chezmoi.homeDir "Developer/blakeports") }} || -d {{ (joinPath .chezmoi.homeDir "Developer/blakeports-private") }} ]]; then
  echo "Configuring macports /opt/local/etc/macports/sources.conf"
  {
    [[ -d {{ (joinPath .chezmoi.homeDir "Developer/blakeports-private") }} ]] && echo "file://{{ (joinPath .chezmoi.homeDir "Developer/blakeports-private") }} [default]"
    [[ -d {{ (joinPath .chezmoi.homeDir "Developer/blakeports") }} ]] && echo "file://{{ (joinPath .chezmoi.homeDir "Developer/blakeports") }} [default]"
    echo "https://mirror.fcix.net/macports/release/tarballs/ports.tar"
  } | sudo tee /opt/local/etc/macports/sources.conf
else
  if ! grep -q "fcix" /opt/local/etc/macports/sources.conf; then
    echo "Configuring macports /opt/local/etc/macports/sources.conf"
    sudo tee /opt/local/etc/macports/sources.conf <<EOF
https://mirror.fcix.net/macports/release/tarballs/ports.tar [default]
EOF
  fi
fi
# MacPorts mirror order: fetch from mirror.fcix.net first, fall back to
# Fastly (packages.macports.org, distfiles.macports.org). Base ranks mirrors
# by ping and Fastly always answers fastest, but it serves files it hasn't
# cached at ~4 MB/s, while fcix serves ~20 MB/s
# (https://trac.macports.org/ticket/65160). preferred_hosts puts fcix first;
# Fastly stays in the list because it has every file, including ones fcix
# hasn't copied yet. Same policy as blakeports scripts/setmirrors.
#
# Also removes what older versions of this script added: an archive_sites.conf
# with an empty `macports_archives` entry (turns off the official archive
# mirrors) plus separate fcix/mit entries, and a macports.conf
# host_blacklist that blocked Fastly outright.
MP_CONF=/opt/local/etc/macports/macports.conf
MP_SITES=/opt/local/etc/macports/archive_sites.conf
MP_MARK="# Mirror order, set by blakeports scripts/setmirrors"
if [[ -f $MP_CONF ]] && mp_tmp=$(mktemp); then
  if awk -v mark="$MP_MARK" '
    $0 == mark { next }
    /^[ \t]*(preferred_hosts|host_blacklist)([ \t]|$)/ { next }
    { line[++n] = $0 }
    END {
      while (n > 0 && line[n] ~ /^[ \t]*$/) n--
      for (i = 1; i <= n; i++) print line[i]
    }' "$MP_CONF" > "$mp_tmp" &&
    printf '\n%s\npreferred_hosts     mirror.fcix.net\nhost_blacklist      rsync.macports.org\n' "$MP_MARK" >> "$mp_tmp" &&
    ! cmp -s "$mp_tmp" "$MP_CONF"; then
    echo "Configuring macports mirror order in $MP_CONF"
    sudo tee "$MP_CONF" < "$mp_tmp" > /dev/null
  fi
  if [[ -f $MP_SITES ]] && awk '
      /^name[ \t]/ { skip = ($2 == "macports_archives" || $2 == "fcix" || $2 == "mit") }
      skip { next }
      { line[++n] = $0 }
      END {
        while (n > 0 && line[n] ~ /^[ \t]*$/) n--
        for (i = 1; i <= n; i++) print line[i]
      }' "$MP_SITES" > "$mp_tmp" && ! cmp -s "$mp_tmp" "$MP_SITES"; then
    echo "Removing old archive site overrides from $MP_SITES"
    sudo tee "$MP_SITES" < "$mp_tmp" > /dev/null
  fi
  rm -f "$mp_tmp"
fi

# macports selfupdate after config
if [[ -e /opt/local/bin/port ]]; then
  sudo /opt/local/bin/port selfupdate
fi

# macports packages to install
PORT_PACKAGES=(
  "git"
  "gh"
  "bash"
  "bash-completion"
  "jq"
  "go"
  "fzf"
  "fastfetch"
  "duf"
  "chezmoi"
  "vault"
  "dotenv"
  "eza"
  "btop"
  "curl"
  "mpstats"
)

# install packages
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
# sudo port selfupdate
for PORT_PACKAGE in "${PORT_PACKAGES[@]}"; do
  if /opt/local/bin/port installed $PORT_PACKAGE | grep -q "None of the specified ports are installed"; then
    echo "Installing $PORT_PACKAGE..."
    if ! sudo /opt/local/bin/port -q install $PORT_PACKAGE; then
      echo "Warning: failed to install $PORT_PACKAGE via macports, skipping"
    fi
  fi
done

# Install source code pro font
if [[ ! -f /Library/Fonts/SourceCodePro-Medium.otf ]]; then
  echo "Installing source code pro font..."
  curl -s -L -o ~/OTF-source-code-pro.zip https://github.com/adobe-fonts/source-code-pro/releases/download/2.038R-ro%2F1.058R-it%2F1.018R-VAR/OTF-source-code-pro-2.038R-ro-1.058R-it.zip
  unzip -o -d /Library/Fonts/ ~/OTF-source-code-pro.zip SourceCodePro-Medium.otf
  rm ~/OTF-source-code-pro.zip
fi

# install any missing Sauce Code Pro Nerd Font Mono faces
sauce_faces=()
for face in Regular Bold Italic BoldItalic; do
  [[ -f /Library/Fonts/SauceCodeProNerdFontMono-${face}.ttf ]] || sauce_faces+=("SauceCodeProNerdFontMono-${face}.ttf")
done
if (( ${#sauce_faces[@]} )); then
  echo "Installing Sauce Code Pro font (${sauce_faces[*]})..."
  curl -L -o ${HOME}/SourceCodePro.zip https://github.com/ryanoasis/nerd-fonts/releases/download/v3.2.1/SourceCodePro.zip
  unzip -o -d /Library/Fonts ${HOME}/SourceCodePro.zip "${sauce_faces[@]}"
  rm ${HOME}/SourceCodePro.zip
fi


# update /etc/shells
if ! grep -q "/opt/local/bin/bash" /etc/shells; then
  sudo tee -a /etc/shells <<<"/opt/local/bin/bash"
fi

# set bash 5 as default shell
if [[ -e /opt/local/bin/bash ]]; then
  sudo chsh -s /opt/local/bin/bash $USER
fi

# set ACL permissions for macports user on home, Developer, and port tree directories (read-only)
# This is idempotent: removes existing macports ACLs before adding the correct one
if id macports &>/dev/null; then
  # Helper function to set ACL idempotently (works for both files and directories)
  set_acl_idempotent() {
    local path="$1"
    local acl_entry="$2"

    if [[ -e "$path" ]]; then
      # Get all ACL entries for macports user using awk for precise parsing
      # ls -led outputs ACL entries as "index: user:macports ..."
      # Extract indices in reverse order to avoid index shifting when removing
      local indices=()
      while IFS= read -r index; do
        [[ -n "$index" ]] && indices+=("$index")
      done < <(/bin/ls -led "$path" 2>/dev/null | /usr/bin/awk '/^[[:space:]]*[0-9]+:.*user:macports/ { sub(/^[[:space:]]*/, ""); split($0, parts, ":"); if (parts[1] ~ /^[0-9]+$/) print parts[1] }')

      # Remove indices in reverse order to avoid shifting
      for (( i=${#indices[@]}-1; i>=0; i-- )); do
        sudo /bin/chmod -a# "${indices[$i]}" "$path" 2>/dev/null
      done

      # Add the correct ACL entry
      sudo /bin/chmod +a "$acl_entry" "$path"
    fi
  }

  # Helper: apply ACL recursively to a port tree directory
  apply_acl_recursive() {
    local dir="$1"
    if [[ -d "$dir" ]]; then
      echo "Applying ACL recursively to $dir..."
      find "$dir" -type d -print0 | while IFS= read -r -d '' d; do
        set_acl_idempotent "$d" "user:macports allow list,search,readattr,readextattr,readsecurity,file_inherit,directory_inherit"
      done
      find "$dir" -type f -print0 | while IFS= read -r -d '' f; do
        set_acl_idempotent "$f" "user:macports allow read,readattr,readextattr,readsecurity"
      done
    fi
  }

  # Home directory traversal (no inheritance)
  set_acl_idempotent {{ .chezmoi.homeDir }} "user:macports allow list,search,readattr,readextattr,readsecurity"

  # Developer directory traversal (no inheritance)
  set_acl_idempotent {{ (joinPath .chezmoi.homeDir "Developer") }} "user:macports allow list,search,readattr,readextattr,readsecurity"

  # blakeports (public port tree)
  set_acl_idempotent {{ (joinPath .chezmoi.homeDir "Developer/blakeports") }} "user:macports allow list,search,readattr,readextattr,readsecurity,file_inherit,directory_inherit"
  apply_acl_recursive {{ (joinPath .chezmoi.homeDir "Developer/blakeports") }}

  # blakeports-private (private port tree)
  set_acl_idempotent {{ (joinPath .chezmoi.homeDir "Developer/blakeports-private") }} "user:macports allow list,search,readattr,readextattr,readsecurity,file_inherit,directory_inherit"
  apply_acl_recursive {{ (joinPath .chezmoi.homeDir "Developer/blakeports-private") }}
fi

# use macports chezmoi if it exists
if [[ -e /opt/local/bin/chezmoi ]]; then
  if [[ -e ~/bin/chezmoi ]]; then
    rm -r ~/bin
  fi
fi

# create /usr/local/bin if it doesn't exist
if [ ! -d "/usr/local/bin" ]; then
  sudo mkdir -p /usr/local/bin
fi

# check for powerline-go
if ! [[ -f /usr/local/bin/powerline-go ]]; then
  echo "Installing powerline-go..."
  POWERLINE_GO_URL=$(github_api 'https://api.github.com/repos/justjanne/powerline-go/releases/latest' | jq -r ".assets[] | select(.name==\"powerline-go-darwin-$ARCH\").browser_download_url" 2>/dev/null)
  if [ -z "$POWERLINE_GO_URL" ]; then
    echo "Warning: could not determine powerline-go download URL (GitHub API rate limit?), skipping"
  else
    curl -L -o "${TMPDIR}powerline-go" "$POWERLINE_GO_URL"
    chmod +x "${TMPDIR}powerline-go"
    sudo mv "${TMPDIR}powerline-go" /usr/local/bin/
  fi
fi

{{ end }}

exit 0

