{{- $python_vers := "3.14" -}}
{{- if stat "/opt/local/bin/python3" -}}
{{-   $raw := output "/opt/local/bin/python3" "--version" | trim -}}
{{-   $python_vers = regexReplaceAll "Python (\\d+\\.\\d+).*" $raw "${1}" -}}
{{- end -}}
# See dotfiles/skills/direnv/SKILL.md for how this works and what
# machine-cfg/claude/settings.json needs for it to take effect.
if [[ -z "$_BASH_ENV_GUARD" ]]; then
  export _BASH_ENV_GUARD=1

{{ if eq .chezmoi.os "darwin" -}}
  export PATH="/opt/local/bin:/opt/local/sbin:/opt/local/Library/Frameworks/Python.framework/Versions/{{ $python_vers }}/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/local/go/bin:{{ .chezmoi.homeDir }}/Developer/go/bin:{{ .chezmoi.homeDir }}/Library/Python/{{ $python_vers }}/bin:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/script:{{ .chezmoi.homeDir }}/Developer/machine-cfg/scripts:{{ .chezmoi.homeDir }}/Developer/machine-cfg/{{ .chezmoi.hostname }}/scripts"
{{ end -}}
{{ if (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg/bash_env")) }}
  # Hash for {{ (joinPath .chezmoi.homeDir "Developer/machine-cfg/bash_env") }} {{ include (joinPath .chezmoi.homeDir "Developer/machine-cfg/bash_env") | sha256sum }}
  # Added content from {{ (joinPath .chezmoi.homeDir "Developer/machine-cfg/bash_env") }}
{{ include (joinPath .chezmoi.homeDir "Developer/machine-cfg/bash_env") }}
{{ end -}}
{{ if (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg/" .chezmoi.hostname "/bash_env")) }}
  # Hash for {{ (joinPath .chezmoi.homeDir "Developer/machine-cfg/" .chezmoi.hostname "/bash_env") }} {{ include (joinPath .chezmoi.homeDir "Developer/machine-cfg/" .chezmoi.hostname "/bash_env") | sha256sum }}
  # Added content from {{ (joinPath .chezmoi.homeDir "Developer/machine-cfg/" .chezmoi.hostname "/bash_env") }}
{{ include (joinPath .chezmoi.homeDir "Developer/machine-cfg/" .chezmoi.hostname "/bash_env") }}
{{ end -}}

fi

if command -v direnv &>/dev/null; then
  _direnv_resolve() {
    local _kv _key _out_keys=$'\n' _n=0
    while IFS= read -r -d '' _kv; do
      _key=${_kv%%=*}
      [[ $_key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      export "$_kv"
      _out_keys+="$_key"$'\n'
      _n=$((_n + 1))
    done < <(env -u BASH_ENV direnv exec . env -0 2>/dev/null)
    if [[ $_n -eq 0 ]]; then
      echo "bash_env: direnv failed to resolve env for $PWD (blocked .envrc? run 'direnv allow')" >&2
      return 0
    fi
    while IFS= read -r -d '' _kv; do
      _key=${_kv%%=*}
      [[ $_key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      [[ $_key == BASH_ENV ]] && continue
      [[ $_out_keys == *$'\n'"$_key"$'\n'* ]] || unset "$_key" 2>/dev/null
    done < <(env -0)
  }
  cd() { builtin cd "$@" && _direnv_resolve; }
  _direnv_resolve
fi
