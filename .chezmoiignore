skills/
docs/

# ignore these files on linux
{{- if eq .chezmoi.os "linux" }}
Library/
.skhdrc
{{ end }}

# ignore these files on mac
{{- if eq .chezmoi.os "darwin" }}
.config/autostart/

{{ end }}

# machine-cfg-backed symlinks must not point at a missing checkout
{{- if not (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg")) }}
.claude/settings.json
.claude/settings.local.json
.codex/config.toml
.config/karabiner
.skhdrc
.ssh/darkstar_ssh.pub
.ssh/far-star_ssh.pub
.ssh/umac_ssh.pub
Library/Application Support/Code/User/mcp.json
{{- end }}

# ssh keys merged into ~/.ssh/authorized_keys; skip if this checkout has neither the shared nor a host authorized_keys
{{- $akDirs := list "Developer" "code" }}
{{- $hasAK := false }}
{{- range $akDirs }}
{{-   if or (stat (joinPath $.chezmoi.homeDir . "machine-cfg/authorized_keys")) (stat (joinPath $.chezmoi.homeDir . "machine-cfg" $.chezmoi.hostname "authorized_keys")) }}{{ $hasAK = true }}{{ end }}
{{- end }}
{{- if not $hasAK }}
.ssh/authorized_keys
{{- end }}

# machine-cfg files that only some upstreams have (personal has neither): don't leave a dangling link
{{- if not (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg/codex/config.toml")) }}
.codex/config.toml
{{- end }}
{{- if not (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg/claude/settings.local.json")) }}
.claude/settings.local.json
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir "Developer/machine-cfg/copilot")) }}
.copilot
{{- end }}

# skip if machine-cfg/aws hasn't been populated on this checkout yet
{{- if not (stat (printf "%s/Developer/machine-cfg/aws/config" .chezmoi.homeDir)) }}
.aws/config
{{- end }}
